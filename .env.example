# Development only. Never use these values in production.
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=unsafe-local-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_CORS_ALLOWED_ORIGINS=
DATABASE_URL=postgresql://primarykit:primarykit_dev@127.0.0.1:5432/primarykit
POSTGRES_DB=primarykit
POSTGRES_USER=primarykit
POSTGRES_PASSWORD=primarykit_dev
POSTGRES_PORT=5432
APP_PORT=8000
# Only set true behind a trusted proxy which overwrites X-Forwarded-Proto.
DJANGO_TRUST_PROXY_SSL_HEADER=false

# Leave false until email verification and abuse prevention are configured.
ALLOW_PUBLIC_REGISTRATION=false

# Email verification and password recovery are opt-in until a mail transport is configured.
AUTH_EMAIL_FLOWS_ENABLED=false
AUTH_VERIFICATION_URL=http://localhost:3000/verify-email
AUTH_PASSWORD_RESET_URL=http://localhost:3000/reset-password
PASSWORD_RESET_TIMEOUT=3600
DEFAULT_FROM_EMAIL=PrimaryKit <no-reply@example.test>
# Configure SMTP for production; see docs/email-notifications.md.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false

# Private upload storage
STORAGE_BACKEND=local
STORAGE_MAX_FILE_BYTES=10485760
# Production: prefer S3-compatible private bucket, or opt in to persistent local volume.
# STORAGE_ALLOW_LOCAL_PRODUCTION=false
# S3_BUCKET=private-media
# S3_REGION=ap-northeast-2
# S3_ENDPOINT_URL=https://s3.example.com
# S3_ADDRESSING_STYLE=path
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ALLOW_INSECURE_ENDPOINT=false

# Optional Redis cache. Install the redis Python package in the client project first.
# Enable explicitly; no cache connection occurs by default.
# Set to django or django-redis ONLY for Django Cache API consumers; native service is default.
REDIS_CACHE_DJANGO_BACKEND=none
REDIS_CACHE_ENABLED=false
REDIS_CACHE_URL=redis://redis:6379/0
REDIS_CACHE_KEY_PREFIX=primarykit-dev
REDIS_CACHE_TIMEOUT=300
REDIS_PORT=6379

# Optional Celery + RabbitMQ. Development-only example credentials; replace in prod.
RABBITMQ_USER=worker
RABBITMQ_PASSWORD=local-worker-only-change-me
RABBITMQ_PORT=5672
CELERY_BROKER_URL=amqp://worker:local-worker-only-change-me@rabbitmq:5672//
# Results optional; if enabled, use a dedicated secured Redis database/instance.
CELERY_RESULT_BACKEND=

# Single-node SeaweedFS S3 overlay, development credentials ONLY.
# Production must replace S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY.
SEAWEEDFS_VERSION=4.48
S3_BUCKET=primarykit-private
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=primarykit-dev
S3_SECRET_ACCESS_KEY=primarykit-dev-secret-change-me
