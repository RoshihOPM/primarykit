# Development only. Never use these values in production.
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=unsafe-local-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_CORS_ALLOWED_ORIGINS=
DATABASE_URL=postgresql://primarykit:primarykit_dev@127.0.0.1:5432/primarykit
POSTGRES_DB=primarykit
POSTGRES_USER=primarykit
POSTGRES_PASSWORD=primarykit_dev
POSTGRES_PORT=5432
APP_PORT=8000
# Only set true behind a trusted proxy which overwrites X-Forwarded-Proto.
DJANGO_TRUST_PROXY_SSL_HEADER=false

# Leave false until email verification and abuse prevention are configured.
ALLOW_PUBLIC_REGISTRATION=false
